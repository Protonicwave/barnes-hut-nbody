import numpy as np
from numpy.typing import NDArray

Vectors = NDArray[np.float64]
Scalars = NDArray[np.float64]

def plummer_sphere(count: int, seed: int) -> tuple[Vectors, Vectors, Scalars]: ...
def uniform_sphere(count: int, seed: int) -> tuple[Vectors, Vectors, Scalars]: ...
def kepler_binary(
    eccentricity: float, semi_major_axis: float
) -> tuple[Vectors, Vectors, Scalars]: ...

class Simulation:
    def __init__(
        self,
        positions: Vectors,
        velocities: Vectors,
        masses: Scalars,
        *,
        dt: float,
        softening: float,
        method: str = "tree",
        theta: float = 0.5,
        threads: int = 1,
    ) -> None: ...
    def step(self, count: int = 1) -> None: ...
    @property
    def time(self) -> float: ...
    @property
    def positions(self) -> Vectors: ...
    @property
    def velocities(self) -> Vectors: ...
    @property
    def masses(self) -> Scalars: ...
    def kinetic_energy(self) -> float: ...
    def potential_energy(self) -> float: ...
    def total_energy(self) -> float: ...
